# Written by the plugin at runtime and specific to one person's workspace
# (identityUserId, pinned conversations, panel geometry).
settings.json

# Local editor / backup noise
# .qmlls.ini holds an absolute import path, so it stays out of the repo.
.qmlls.ini
*.bak
*.bak-*
*~

# Native build output. The helper normally builds into the cache dir, but
# `make` on its own puts it here.
build/
*.o

# Byte-compiled Python from py_compile runs
__pycache__/
